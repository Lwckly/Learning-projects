      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"deltas", "[", 
            RowBox[{"[", 
             RowBox[{"j", "-", "1"}], "]"}], "]"}], "-", "deltaTeor"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "3", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"6", ",", 
           RowBox[{
            RowBox[{"Length", "[", "deltas", "]"}], "+", "1"}]}], "]"}]}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ajuste", "=", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"dados", ",", 
       RowBox[{"c1", "*", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "c2"}], "*", "j"}], "]"}]}], ",", 
