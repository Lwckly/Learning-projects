   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lyap", "[", 
     RowBox[{"a_", ",", "x0_", ",", "niter_", ",", "ntrans_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "=", "x0"}], ",", 
        RowBox[{"soma", "=", "0."}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"g", "[", 
           RowBox[{"a", ",", "x"}], "]"}]}], ",", 
         RowBox[{"{", "ntrans", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"soma", "+=", 
           RowBox[{"Log", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"a", "*", "Pi", "*", 
              RowBox[{"Cos", "[", 
               RowBox[{"Pi", "*", "x"}], "]"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "=", 
           RowBox[{"g", "[", 
            RowBox[{"a", ",", "x"}], "]"}]}]}], ",", 
         RowBox[{"{", "niter", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"soma", "/", "niter"}]}]}], "]"}]}], "\[IndentingNewLine]", 
