Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PROBLEMA", " ", "2"}], "\[Dash]", 
    RowBox[{"P\[EHat]ndulo", " ", "n\[ATilde]o", " ", "linear"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"T", "[", 
     RowBox[{"\[Theta]0_", ",", "\[ScriptL]_", ",", "g_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"8", " ", 
       RowBox[{"\[ScriptL]", "/", "g"}]}], "]"}], " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], "-", 
          RowBox[{"Cos", "[", "\[Theta]0", "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", "\[Theta]0"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"0", "<", "\[Theta]0", "<", "\[Pi]"}]}]}], "]"}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Teste", " ", "limite", " ", "\[Theta]0", " ", "pequeno"}], "\[RightArrow]", 
     RowBox[{"2", "\[Pi]", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"\[ScriptL]", "/", "g"}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"T", "[", 
      RowBox[{"\[Theta]0", ",", "\[ScriptL]", ",", "g"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Theta]0", "->", "0"}], ",", 
       RowBox[{"\[ScriptL]", ">", "0"}], ",", 
       RowBox[{"g", ">", "0"}]}], "}"}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Valor", " ", "num\[EAcute]rico", " ", "para", " ", "\[Theta]0"}], "=", 
      RowBox[{"45", "\[Degree]"}]}], ",", 
     RowBox[{"\[ScriptL]", "=", "1"}], ",", 
     RowBox[{"g", "=", "9.8"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Tnum", "=", 
    RowBox[{"N", "[", 
     RowBox[{"T", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "4"}], ",", "1", ",", "9.8"}], "]"}], "]"}]}], "\n", 
   RowBox[{"Tsmall", "=", 
    RowBox[{"2", " ", "\[Pi]", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "/", "9.8"}], "]"}]}]}], "\n", 
   RowBox[{"Tnum", "/", "Tsmall"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "raz\[ATilde]o", " ", "entre", " ", "per\[IAcute]odo", " ", "real", " ", 
     "e", " ", "aproximado"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Equa\[CCedilla]\[ATilde]o", " ", "de", " ", 
      RowBox[{"movimento", ":", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"g", "/", "\[ScriptL]"}], ")"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}]}]}], "=", "0"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solPend", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[Theta]", "''"}], "[", "t", "]"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"9.8", "/", "1"}], ")"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Theta]", "[", "t", "]"}], "]"}]}]}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
          RowBox[{"Pi", "/", "4"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Theta]", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}], ",",
        "\[Theta]", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"10", " ", "Tnum"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solu\[CCedilla]\[ATilde]o", " ", "aproximada", " ", 
     RowBox[{"(", "harm\[OHat]nica", ")"}], " ", "para", " ", 
     "compara\[CCedilla]\[ATilde]o"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Theta]approx", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Pi", "/", "4"}], ")"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"9.8", "/", "1"}], "]"}], " ", "t"}], "]"}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Gr\[AAcute]fico", " ", "\[Theta]", 
     RowBox[{"(", "t", ")"}], " ", "exato", " ", "e", " ", "aproximado"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"\[Theta]", "[", "t", "]"}], "/.", " ", 
         RowBox[{"solPend", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"\[Theta]approx", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"10", " ", "Tnum"}]}], "}"}], ",", 
     "\[IndentingNewLine]"}]}]}]}]], "Input",
