Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PROBLEMA", " ", "1"}], "\[Dash]", 
    RowBox[{"Queda", " ", "livre"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Fun\[CCedilla]\[ATilde]o", " ", 
    RowBox[{"posi\[CCedilla]\[ATilde]o", ":", 
     RowBox[{
     "queda", " ", "livre", " ", "a", " ", "partir", " ", "do", " ", 
      "repouso"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "[", "t_", "]"}], ":=", 
    RowBox[{"h", "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", "g", " ", 
      RowBox[{"t", "^", "2"}]}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1", ")"}], " ", "Derivar", " ", "para", " ", "achar", " ", "a", 
     " ", "velocidade"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"v", "[", "t_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"2", ")"}], " ", "Substituir", " ", "g"}], "=", 
     RowBox[{
      RowBox[{"9.8", " ", "e", " ", "h"}], "=", "100"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"pos100", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "->", "100"}], ",", 
       RowBox[{"g", "->", "9.8"}]}], "}"}]}]}], "\n", 
   RowBox[{
    RowBox[{"vel100", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"v", "[", "t", "]"}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "->", "100"}], ",", 
       RowBox[{"g", "->", "9.8"}]}], "}"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3", ")"}], " ", "Determinar", " ", "tempo", " ", "at\[EAcute]", 
     " ", "atingir", " ", "o", " ", "solo", " ", 
     RowBox[{"(", 
      RowBox[{"x", "=", "0"}], ")"}]}], "*)"}], "\n", 
   RowBox[{"tQueda", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pos100", "[", "t", "]"}], "==", "0"}], ",", "t"}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Pegamos", " ", "a", " ", "raiz", " ", "positiva"}], "*)"}], "\n", 
   RowBox[{"tempoSolo", "=", 
    RowBox[{"t", "/.", " ", 
     RowBox[{"tQueda", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4", ")"}], " ", "Gr\[AAcute]fico", " ", "da", " ", 
     "posi\[CCedilla]\[ATilde]o", " ", "at\[EAcute]", " ", "o", " ", "solo"}],
     "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"pos100", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tempoSolo"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t (s)\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "Large", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"tempoSolo", ",", "0"}], "}"}], "]"}]}], "}"}]}]}], "]"}], 
