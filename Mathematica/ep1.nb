Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PROBLEMA", " ", "3"}], "\[Dash]", 
    RowBox[{"Lan\[CCedilla]amento", " ", "vertical"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Fun\[CCedilla]\[ATilde]o", " ", 
    RowBox[{"posi\[CCedilla]\[ATilde]o", ":", 
     RowBox[{"lan\[CCedilla]amento", " ", "para", " ", "cima"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x3", "[", "t_", "]"}], ":=", 
    RowBox[{"h0", "+", 
     RowBox[{"v0", " ", "t"}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", "g", " ", 
      RowBox[{"t", "^", "2"}]}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1", ")"}], " ", "Derivar", " ", "para", " ", "obter", " ", 
     "velocidade"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v3", "[", "t_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"x3", "[", "t", "]"}], ",", "t"}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"2", ")"}], " ", "Substituir", " ", "h0"}], "=", "0"}], ",", 
     RowBox[{"v0", "=", "20"}], ",", 
     RowBox[{"g", "=", "9.8"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"posLanc", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"x3", "[", "t", "]"}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h0", "->", "0"}], ",", 
       RowBox[{"v0", "->", "20"}], ",", 
       RowBox[{"g", "->", "9.8"}]}], "}"}]}]}], "\n", 
   RowBox[{
    RowBox[{"velLanc", "[", "t_", "]"}], "=", 
    RowBox[{
     RowBox[{"v3", "[", "t", "]"}], "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h0", "->", "0"}], ",", 
       RowBox[{"v0", "->", "20"}], ",", 
       RowBox[{"g", "->", "9.8"}]}], "}"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3", ")"}], " ", "Instante", " ", "em", " ", "que", " ", "a", " ",
      "velocidade", " ", "zera", " ", 
     RowBox[{"(", 
      RowBox[{"ponto", " ", "mais", " ", "alto"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"tPico", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"velLanc", "[", "t", "]"}], "==", "0"}], ",", "t"}], "]"}]}], "\n", 
   RowBox[{"tempoPico", "=", 
    RowBox[{"t", "/.", " ", 
     RowBox[{"tPico", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
